<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow" Title="GPT + 硬件驾驶舱" Width="960" Height="640"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        Background="#10151D" Foreground="#EAF0F6" FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#B7C3D2"/>
      <Setter Property="Background" Value="#1A2330"/>
      <Setter Property="BorderBrush" Value="#2B3747"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#29374A"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#76DCC4"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Small" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#A8B7C9"/></Style>
  </Window.Resources>
  <Viewbox x:Name="ScaleBox" Stretch="Uniform">
    <Grid x:Name="Dashboard" Width="960" Height="640" Background="#10151D">
      <Border Height="2" VerticalAlignment="Top">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#70DCC3" Offset="0"/><GradientStop Color="#9DABED" Offset="0.65"/><GradientStop Color="#10151D" Offset="1"/></LinearGradientBrush></Border.Background>
      </Border>
      <Grid Margin="24,12,24,12">
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="8"/><RowDefinition Height="358"/><RowDefinition Height="10"/><RowDefinition Height="200"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="Header" Grid.Row="0" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            
            <Border x:Name="ModeBadge" Background="#213832" CornerRadius="5" Padding="12,5" Margin="0"><TextBlock x:Name="ModeLabel" Text="GPT / CODEX" FontSize="20" FontWeight="SemiBold" Foreground="#8CE1CA"/></Border>
            <TextBlock x:Name="PlanLabel" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="160,0,0,0" Visibility="Collapsed"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#8DA5C9" Margin="0,0,7,0"/><TextBlock x:Name="StatusTitle" Text="正在连接 Codex" FontSize="12" Foreground="#B4C2D4"/></StackPanel>
          <TextBlock x:Name="Clock" Text="00:00:00" FontFamily="Consolas" FontSize="27" Foreground="#E0E8F4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          <TextBlock x:Name="DateLabel" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusDetail" Visibility="Collapsed"/>
          <TextBlock x:Name="NextLabel" Visibility="Collapsed"/>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>          <Border Grid.Column="0" Background="#17232B" BorderBrush="#29413F" BorderThickness="1" CornerRadius="16">
            <Grid Margin="23,11,23,11">
              <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="224"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock x:Name="ShortTitle" Text="5 小时额度" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock x:Name="ShortHint" HorizontalAlignment="Right" Foreground="#83E2C9" FontSize="12" VerticalAlignment="Center"/>
              <Viewbox Grid.Row="1" Stretch="Uniform"><Canvas Width="398" Height="256">
                <Canvas x:Name="ShortTicks" Width="398" Height="256"/>
                <Path x:Name="ShortTrack" Stroke="#334454" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="ShortArc" Stroke="#83E2C9" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse x:Name="ShortMarker" Width="17" Height="17" Fill="#F4FAFF" Stroke="#83E2C9" StrokeThickness="3" Visibility="Collapsed"/>
                <Grid Canvas.Top="35" Width="398"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="ShortValue" Text="--" FontSize="140" FontWeight="SemiBold" Foreground="#83E2C9" FontFamily="Segoe UI"/><TextBlock Text="%" FontSize="30" Foreground="#83E2C9" VerticalAlignment="Bottom" Margin="3,0,0,31"/></StackPanel></Grid>
                <TextBlock Text="剩余额度" Canvas.Top="197" Width="398" TextAlignment="Center" FontSize="16" Foreground="#CAD6E3"/>
                <TextBlock x:Name="ShortUsed" Text="等待同步" Canvas.Top="225" Width="398" TextAlignment="Center" FontSize="13" Foreground="#9CACBE"/>
              </Canvas></Viewbox>
              <Border Grid.Row="2" BorderBrush="#29413F" BorderThickness="0,1,0,0" Padding="4,7,4,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock Text="下次重置" FontSize="12" Foreground="#A7B8CB"/>
                  <TextBlock x:Name="ShortResetDate" Visibility="Collapsed"/>
                  <TextBlock x:Name="ShortReset" Grid.Row="1" Text="--" FontSize="32" FontWeight="Medium" Foreground="#EDF3FA" VerticalAlignment="Center"/>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ShortCountdownLead" Text="还有" FontSize="12" Foreground="#93A6BD" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="ShortCountdown" Text="--" FontSize="32" FontWeight="Medium" FontFamily="Consolas" Foreground="#C5D3E4" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>          <Border Grid.Column="2" Background="#1E2232" BorderBrush="#373B53" BorderThickness="1" CornerRadius="16">
            <Grid Margin="23,11,23,11">
              <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="224"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock x:Name="WeekTitle" Text="每周额度" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock x:Name="WeekHint" HorizontalAlignment="Right" Foreground="#B9B9F5" FontSize="12" VerticalAlignment="Center"/>
              <Viewbox Grid.Row="1" Stretch="Uniform"><Canvas Width="398" Height="256">
                <Canvas x:Name="WeekTicks" Width="398" Height="256"/>
                <Path x:Name="WeekTrack" Stroke="#334454" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="WeekArc" Stroke="#B9B9F5" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse x:Name="WeekMarker" Width="17" Height="17" Fill="#F4FAFF" Stroke="#B9B9F5" StrokeThickness="3" Visibility="Collapsed"/>
                <Grid Canvas.Top="35" Width="398"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="WeekValue" Text="--" FontSize="140" FontWeight="SemiBold" Foreground="#B9B9F5" FontFamily="Segoe UI"/><TextBlock Text="%" FontSize="30" Foreground="#B9B9F5" VerticalAlignment="Bottom" Margin="3,0,0,31"/></StackPanel></Grid>
                <TextBlock Text="剩余额度" Canvas.Top="197" Width="398" TextAlignment="Center" FontSize="16" Foreground="#CAD6E3"/>
                <TextBlock x:Name="WeekUsed" Text="等待同步" Canvas.Top="225" Width="398" TextAlignment="Center" FontSize="13" Foreground="#9CACBE"/>
              </Canvas></Viewbox>
              <Border Grid.Row="2" BorderBrush="#373B53" BorderThickness="0,1,0,0" Padding="4,7,4,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock Text="下次重置" FontSize="12" Foreground="#A7B8CB"/>
                  <TextBlock x:Name="WeekResetDate" Text="本地时间" FontSize="13" Foreground="#A7B8CB" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="WeekReset" Grid.Row="1" Text="--" FontSize="32" FontWeight="Medium" Foreground="#EDF3FA" VerticalAlignment="Center"/>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="WeekCountdownLead" Text="还有" FontSize="12" Foreground="#93A6BD" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="WeekCountdown" Text="--" FontSize="32" FontWeight="Medium" FontFamily="Consolas" Foreground="#C5D3E4" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>        </Grid>
        <Border Grid.Row="4" BorderBrush="#344C73" BorderThickness="1" CornerRadius="16" Padding="18,14">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#172733" Offset="0"/><GradientStop Color="#191F31" Offset="0.55"/><GradientStop Color="#17243A" Offset="1"/></LinearGradientBrush></Border.Background>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>

            <Grid Margin="7,0,19,0">
              <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="70"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid>
                <TextBlock Text="CPU" FontSize="28" FontWeight="SemiBold" Foreground="#83E2C9" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.RenderTransform><TranslateTransform Y="-7"/></StackPanel.RenderTransform>
                <TextBlock x:Name="CpuUsage" Text="--" FontSize="64" FontWeight="SemiBold" Foreground="#E9F7F3" FontFamily="Segoe UI"/>
                <TextBlock Text="%" FontSize="24" Foreground="#83E2C9" VerticalAlignment="Bottom" Margin="4,0,0,12"/>
              </StackPanel>
              <Border Grid.Row="2" Width="238" Height="10" CornerRadius="5" Background="#31434C" HorizontalAlignment="Center">
                <Border x:Name="CpuFill" Width="0" CornerRadius="5" Background="#83E2C9" HorizontalAlignment="Left"/>
              </Border>
              <Grid Grid.Row="3" Margin="7,8,7,0">
                <TextBlock x:Name="CpuTemp" Text="温度  -- ℃" FontSize="20" FontWeight="Medium" Foreground="#D7E4EB" HorizontalAlignment="Left"/>
                <TextBlock x:Name="CpuClock" Text="频率  -- GHz" FontSize="20" FontWeight="Medium" Foreground="#BBC9D4" HorizontalAlignment="Right"/>
              </Grid>
            </Grid>

            <Border Grid.Column="1" Background="#334354"/>

            <Grid Grid.Column="2" Margin="19,0">
              <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="70"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid>
                <TextBlock Text="GPU" FontSize="28" FontWeight="SemiBold" Foreground="#B9B9F5" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.RenderTransform><TranslateTransform Y="-7"/></StackPanel.RenderTransform>
                <TextBlock x:Name="GpuUsage" Text="--" FontSize="64" FontWeight="SemiBold" Foreground="#F1F0FF" FontFamily="Segoe UI"/>
                <TextBlock Text="%" FontSize="24" Foreground="#B9B9F5" VerticalAlignment="Bottom" Margin="4,0,0,12"/>
              </StackPanel>
              <Border Grid.Row="2" Width="238" Height="10" CornerRadius="5" Background="#393C55" HorizontalAlignment="Center">
                <Border x:Name="GpuFill" Width="0" CornerRadius="5" Background="#B9B9F5" HorizontalAlignment="Left"/>
              </Border>
              <Grid Grid.Row="3" Margin="7,8,7,0">
                <TextBlock x:Name="GpuTemp" Text="温度  -- ℃" FontSize="18" FontWeight="Medium" Foreground="#E3E2F7" HorizontalAlignment="Left"/>
                <TextBlock x:Name="GpuMemory" Text="显存  --" FontSize="18" FontWeight="Medium" Foreground="#CACBE0" HorizontalAlignment="Right"/>
              </Grid>
            </Grid>

            <Border Grid.Column="3" Background="#334354"/>

            <Grid Grid.Column="4" Margin="19,0,7,0">
              <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="70"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid>
                <TextBlock Text="RAM" FontSize="28" FontWeight="SemiBold" Foreground="#86B1FF" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.RenderTransform><TranslateTransform Y="-7"/></StackPanel.RenderTransform>
                <TextBlock x:Name="RamUsage" Text="--" FontSize="64" FontWeight="SemiBold" Foreground="#EEF4FF" FontFamily="Segoe UI"/>
                <TextBlock Text="%" FontSize="24" Foreground="#86B1FF" VerticalAlignment="Bottom" Margin="4,0,0,12"/>
              </StackPanel>
              <Border Grid.Row="2" Width="238" Height="10" CornerRadius="5" Background="#30415A" HorizontalAlignment="Center">
                <Border x:Name="RamFill" Width="0" CornerRadius="5" Background="#86B1FF" HorizontalAlignment="Left"/>
              </Border>
              <Grid Grid.Row="3" Margin="7,8,7,0">
                <TextBlock x:Name="RamUsed" Text="已用  --" FontSize="20" FontWeight="Medium" Foreground="#D6E1F0" HorizontalAlignment="Center"/>
              </Grid>
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Row="5" Visibility="Collapsed" Margin="0,8,0,0" VerticalAlignment="Bottom">
          <TextBlock x:Name="ScreenLabel" Visibility="Collapsed"/>
          <TextBlock x:Name="SyncLabel" Text="GPT 等待同步" Foreground="#91A2B9" FontSize="12" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton" Content="刷新 R" ToolTip="刷新 GPT 与硬件状态"/>
            <Button x:Name="ScreenButton" Content="切换屏幕" Margin="7,0,0,0"/>
            <Button x:Name="PinButton" Content="置顶" Margin="7,0,0,0"/>
            <Button x:Name="WindowButton" Content="窗口" Margin="7,0,0,0"/>
            <Button x:Name="CloseButton" Content="退出" Margin="7,0,0,0"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Viewbox>
</Window>
